# ============================================================
# EmbedAI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# Generate secure JWT secrets with:
#   openssl rand -hex 64
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed frontend origins
# Example for production: https://app.embedai.com,https://www.embedai.com
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
MONGO_URI=your_mongodb_atlas_connection_string_here

# --- JWT Secrets (MUST be strong random strings — use openssl rand -hex 64) ---
JWT_ACCESS_SECRET=REPLACE_WITH_OUTPUT_OF___openssl_rand_-hex_64
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_OUTPUT_OF___openssl_rand_-hex_64

# --- AI Models ---
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_MODEL=claude-3-haiku-20240307
OPENAI_API_MODEL=gpt-4o-mini

# --- Optional: LangSmith Tracing ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=EmbedAI_Production

# --- Optional: Logging ---
# LOG_LEVEL=debug  # debug | info | warn | error